@model PAP.DataAccess.Address

@{
    ViewBag.Title = "Detalle Dirección";
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Detalle de Dirección</h1>
        <div>
            @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@(Model.Customer != null ? Model.Customer.Email : "-")</dd>
        <dt class="col-sm-3">Tipo de dirección</dt>
        <dd class="col-sm-9">@Model.AddressType</dd>
        <dt class="col-sm-3">Calle</dt>
        <dd class="col-sm-9">@Model.Street</dd>
        <dt class="col-sm-3">Ciudad</dt>
        <dd class="col-sm-9">@Model.City</dd>
        <dt class="col-sm-3">Provincia/Estado</dt>
        <dd class="col-sm-9">@Model.State</dd>
        <dt class="col-sm-3">Código postal</dt>
        <dd class="col-sm-9">@Model.PostalCode</dd>
        <dt class="col-sm-3">País</dt>
        <dd class="col-sm-9">@Model.Country</dd>
        <dt class="col-sm-3">Predeterminada</dt>
        <dd class="col-sm-9">@(Model.IsDefault ? "Sí" : "No")</dd>
    </dl>
</main>
