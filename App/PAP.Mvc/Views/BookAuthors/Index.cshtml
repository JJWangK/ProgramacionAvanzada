@model IEnumerable<PAP.Models.BookAuthor>

@{
    ViewBag.Title = "Libros y autores";
    var items = Model != null ? Model.ToList() : new List<PAP.Models.BookAuthor>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-0">Libros y autores</h1>
            <p class="text-muted mb-0">@items.Count relación@(items.Count == 1 ? "" : "es")</p>
        </div>
        @Html.ActionLink("Nuevo", "Create", new { }, new { @class = "btn btn-primary" })
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Mensaje"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">No hay relaciones para mostrar.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Libro</th>
                        <th scope="col">Autor</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.BookTitle</td>
                            <td>@item.AuthorName</td>
                            <td class="text-end text-nowrap">
                                @Html.ActionLink("Editar", "Edit", new { bookId = item.BookId, authorId = item.AuthorId }, new { @class = "btn btn-sm btn-outline-primary" })
                                @Html.ActionLink("Detalle", "Details", new { bookId = item.BookId, authorId = item.AuthorId }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Eliminar", "Delete", new { bookId = item.BookId, authorId = item.AuthorId }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
