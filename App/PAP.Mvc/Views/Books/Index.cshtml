@model IEnumerable<PAP.DataAccess.Book>

@{
    ViewBag.Title = "Libros";
    var items = Model != null ? Model.ToList() : new List<PAP.DataAccess.Book>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-0">Libros</h1>
            <p class="text-muted mb-0">@items.Count registro@(items.Count == 1 ? "" : "s")</p>
        </div>
        @Html.ActionLink("Nuevo", "Create", new { }, new { @class = "btn btn-primary" })
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Mensaje"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">No hay registros para mostrar.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Título</th>
                        <th scope="col">Autor</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Editorial</th>
                        <th scope="col">Género</th>
                        <th scope="col">Precio</th>
                        <th scope="col">En stock</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@item.Author</td>
                            <td>@(item.Category1 != null ? item.Category1.Name : (item.Category ?? "-"))</td>
                            <td>@(item.Publisher1 != null ? item.Publisher1.Name : (item.Publisher ?? "-"))</td>
                            <td>@(item.Genre1 != null ? item.Genre1.Name : (item.Genre ?? "-"))</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@(item.IsInStock ? "Sí" : "No")</td>
                            <td class="text-end text-nowrap">
                                @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                                @Html.ActionLink("Detalle", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
