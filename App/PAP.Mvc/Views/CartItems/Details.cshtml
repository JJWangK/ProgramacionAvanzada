@model PAP.DataAccess.CartItem

@{
    ViewBag.Title = "Detalle Ítem de carrito";
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Detalle de Ítem de carrito</h1>
        <div>
            @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Carrito</dt>
        <dd class="col-sm-9">@(Model.ShoppingCart != null ? (object)Model.ShoppingCart.Id : "-")</dd>
        <dt class="col-sm-3">Libro</dt>
        <dd class="col-sm-9">@(Model.Book != null ? Model.Book.Title : "-")</dd>
        <dt class="col-sm-3">Cantidad</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>
        <dt class="col-sm-3">Agregado</dt>
        <dd class="col-sm-9">@Model.AddedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</main>
