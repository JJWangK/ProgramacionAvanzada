@model PAP.DataAccess.Customer

@{
    ViewBag.Title = "Editar Cliente";
}

<main>
    <h1 class="h2 mb-4">Editar Cliente</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.CreatedAt)

            <div class="mb-3">
                @Html.LabelFor(m => m.FirstName, "Nombre", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.LastName, "Apellido", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Email, "Correo", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.PasswordHash, "Contraseña", new { @class = "form-label" })
                @Html.PasswordFor(m => m.PasswordHash, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PasswordHash, "", new { @class = "text-danger" })
                <div class="form-text">Dejar vacío al editar para conservar la contraseña actual.</div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Phone, "Teléfono", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.BirthDate, "Fecha de nacimiento", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.BirthDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.BirthDate, "", new { @class = "text-danger" })
            </div>

            <div class="form-check mb-3">
                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.IsActive, "Activo", new { @class = "form-check-label" })
            </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            @Html.ActionLink("Cancelar", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</main>
