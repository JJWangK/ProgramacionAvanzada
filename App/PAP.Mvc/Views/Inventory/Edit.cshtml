@model PAP.DataAccess.Inventory

@{
    ViewBag.Title = "Editar Inventario";
}

<main>
    <h1 class="h2 mb-4">Editar Inventario</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        @Html.HiddenFor(m => m.Id)

            <div class="mb-3">
                @Html.LabelFor(m => m.BookId, "Libro", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.BookId, (SelectList)ViewBag.BookIdList, "-- Seleccione --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.BookId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.QuantityInStock, "Cantidad en stock", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.QuantityInStock, new { @class = "form-control", type = "number", step = "1" })
                @Html.ValidationMessageFor(m => m.QuantityInStock, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.ReorderLevel, "Nivel de reposición", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.ReorderLevel, new { @class = "form-control", type = "number", step = "1" })
                @Html.ValidationMessageFor(m => m.ReorderLevel, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.LastRestockedAt, "Último reabastecimiento", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.LastRestockedAt, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                @Html.ValidationMessageFor(m => m.LastRestockedAt, "", new { @class = "text-danger" })
            </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            @Html.ActionLink("Cancelar", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</main>
