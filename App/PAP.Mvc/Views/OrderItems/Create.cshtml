@model PAP.DataAccess.OrderItem

@{
    ViewBag.Title = "Crear Ítem de pedido";
}

<main>
    <h1 class="h2 mb-4">Crear Ítem de pedido</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })



            <div class="mb-3">
                @Html.LabelFor(m => m.OrderId, "Pedido", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.OrderId, (SelectList)ViewBag.OrderIdList, "-- Seleccione --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.OrderId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.BookId, "Libro", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.BookId, (SelectList)ViewBag.BookIdList, "-- Seleccione --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.BookId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Quantity, "Cantidad", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number", step = "1" })
                @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.UnitPrice, "Precio unitario", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.UnitPrice, new { @class = "form-control", type = "number", step = "0.01" })
                @Html.ValidationMessageFor(m => m.UnitPrice, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Discount, "Descuento", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Discount, new { @class = "form-control", type = "number", step = "0.01" })
                @Html.ValidationMessageFor(m => m.Discount, "", new { @class = "text-danger" })
            </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            @Html.ActionLink("Cancelar", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</main>
