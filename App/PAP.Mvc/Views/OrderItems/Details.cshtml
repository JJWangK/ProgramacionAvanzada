@model PAP.DataAccess.OrderItem

@{
    ViewBag.Title = "Detalle Ítem de pedido";
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Detalle de Ítem de pedido</h1>
        <div>
            @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Pedido</dt>
        <dd class="col-sm-9">@(Model.Order != null ? (object)Model.Order.Id : "-")</dd>
        <dt class="col-sm-3">Libro</dt>
        <dd class="col-sm-9">@(Model.Book != null ? Model.Book.Title : "-")</dd>
        <dt class="col-sm-3">Cantidad</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>
        <dt class="col-sm-3">Precio unitario</dt>
        <dd class="col-sm-9">@Model.UnitPrice.ToString("C")</dd>
        <dt class="col-sm-3">Descuento</dt>
        <dd class="col-sm-9">@Model.Discount.ToString("C")</dd>
    </dl>
</main>
