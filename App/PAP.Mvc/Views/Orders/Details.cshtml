@model PAP.DataAccess.Order

@{
    ViewBag.Title = "Detalle Pedido";
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Detalle de Pedido</h1>
        <div>
            @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@(Model.Customer != null ? Model.Customer.Email : "-")</dd>
        <dt class="col-sm-3">Dirección de envío</dt>
        <dd class="col-sm-9">@(Model.Address != null ? Model.Address.Street : "-")</dd>
        <dt class="col-sm-3">Fecha del pedido</dt>
        <dd class="col-sm-9">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</dd>
        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Subtotal</dt>
        <dd class="col-sm-9">@Model.Subtotal.ToString("C")</dd>
        <dt class="col-sm-3">Impuesto</dt>
        <dd class="col-sm-9">@Model.TaxAmount.ToString("C")</dd>
        <dt class="col-sm-3">Envío</dt>
        <dd class="col-sm-9">@Model.ShippingCost.ToString("C")</dd>
        <dt class="col-sm-3">Total</dt>
        <dd class="col-sm-9">@Model.Total.ToString("C")</dd>
        <dt class="col-sm-3">Notas</dt>
        <dd class="col-sm-9">@Model.Notes</dd>
        <dt class="col-sm-3">Actualizado</dt>
        <dd class="col-sm-9">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</main>
