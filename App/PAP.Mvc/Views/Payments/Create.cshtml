@model PAP.DataAccess.Payment

@{
    ViewBag.Title = "Crear Pago";
}

<main>
    <h1 class="h2 mb-4">Crear Pago</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })



            <div class="mb-3">
                @Html.LabelFor(m => m.OrderId, "Pedido", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.OrderId, (SelectList)ViewBag.OrderIdList, "-- Seleccione --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.OrderId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.PaymentMethod, "Método de pago", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.PaymentMethod, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Amount, "Monto", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
                @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.PaymentDate, "Fecha de pago", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.PaymentDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                @Html.ValidationMessageFor(m => m.PaymentDate, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Status, "Estado", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Status, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.TransactionRef, "Referencia", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.TransactionRef, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.TransactionRef, "", new { @class = "text-danger" })
            </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            @Html.ActionLink("Cancelar", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</main>
