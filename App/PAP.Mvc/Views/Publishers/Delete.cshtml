@model PAP.DataAccess.Publisher

@{
    ViewBag.Title = "Eliminar Editorial";
}

<main>
    <h1 class="h2 mb-4">Eliminar Editorial</h1>

    <div class="alert alert-warning" role="alert">
        ¿Está seguro de eliminar este registro?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">País</dt>
        <dd class="col-sm-9">@Model.Country</dd>
        <dt class="col-sm-3">Sitio web</dt>
        <dd class="col-sm-9">@Model.Website</dd>
        <dt class="col-sm-3">Correo</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <button type="submit" class="btn btn-danger">Eliminar</button>
        @Html.ActionLink("Cancelar", "Index", new { }, new { @class = "btn btn-outline-secondary" })
    }
</main>
