@model PAP.DataAccess.Publisher

@{
    ViewBag.Title = "Detalle Editorial";
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Detalle de Editorial</h1>
        <div>
            @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">País</dt>
        <dd class="col-sm-9">@Model.Country</dd>
        <dt class="col-sm-3">Sitio web</dt>
        <dd class="col-sm-9">@Model.Website</dd>
        <dt class="col-sm-3">Correo</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Creado</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>
</main>
