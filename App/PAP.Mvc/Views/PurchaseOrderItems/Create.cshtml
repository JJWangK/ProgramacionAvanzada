@model PAP.DataAccess.PurchaseOrderItem

@{
    ViewBag.Title = "Crear Ítem de orden de compra";
}

<main>
    <h1 class="h2 mb-4">Crear Ítem de orden de compra</h1>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })



            <div class="mb-3">
                @Html.LabelFor(m => m.PurchaseOrderId, "Orden de compra", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.PurchaseOrderId, (SelectList)ViewBag.PurchaseOrderIdList, "-- Seleccione --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.PurchaseOrderId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.BookId, "Libro", new { @class = "form-label" })
                @Html.DropDownListFor(m => m.BookId, (SelectList)ViewBag.BookIdList, "-- Seleccione --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.BookId, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Quantity, "Cantidad", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Quantity, new { @class = "form-control", type = "number", step = "1" })
                @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.UnitCost, "Costo unitario", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.UnitCost, new { @class = "form-control", type = "number", step = "0.01" })
                @Html.ValidationMessageFor(m => m.UnitCost, "", new { @class = "text-danger" })
            </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            @Html.ActionLink("Cancelar", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</main>
