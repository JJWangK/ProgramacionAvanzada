@model PAP.DataAccess.PurchaseOrderItem

@{
    ViewBag.Title = "Eliminar Ítem de orden de compra";
}

<main>
    <h1 class="h2 mb-4">Eliminar Ítem de orden de compra</h1>

    <div class="alert alert-warning" role="alert">
        ¿Está seguro de eliminar este registro?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Orden de compra</dt>
        <dd class="col-sm-9">@(Model.PurchaseOrder != null ? (object)Model.PurchaseOrder.Id : "-")</dd>
        <dt class="col-sm-3">Libro</dt>
        <dd class="col-sm-9">@(Model.Book != null ? Model.Book.Title : "-")</dd>
        <dt class="col-sm-3">Cantidad</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>
        <dt class="col-sm-3">Costo unitario</dt>
        <dd class="col-sm-9">@Model.UnitCost.ToString("C")</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <button type="submit" class="btn btn-danger">Eliminar</button>
        @Html.ActionLink("Cancelar", "Index", new { }, new { @class = "btn btn-outline-secondary" })
    }
</main>
