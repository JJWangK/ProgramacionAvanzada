@model PAP.DataAccess.PurchaseOrderItem

@{
    ViewBag.Title = "Detalle Ítem de orden de compra";
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Detalle de Ítem de orden de compra</h1>
        <div>
            @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Volver", "Index", new { }, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Orden de compra</dt>
        <dd class="col-sm-9">@(Model.PurchaseOrder != null ? (object)Model.PurchaseOrder.Id : "-")</dd>
        <dt class="col-sm-3">Libro</dt>
        <dd class="col-sm-9">@(Model.Book != null ? Model.Book.Title : "-")</dd>
        <dt class="col-sm-3">Cantidad</dt>
        <dd class="col-sm-9">@Model.Quantity</dd>
        <dt class="col-sm-3">Costo unitario</dt>
        <dd class="col-sm-9">@Model.UnitCost.ToString("C")</dd>
    </dl>
</main>
