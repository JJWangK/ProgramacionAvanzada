@model PAP.DataAccess.ShoppingCart

@{
    ViewBag.Title = "Eliminar Carrito";
}

<main>
    <h1 class="h2 mb-4">Eliminar Carrito</h1>

    <div class="alert alert-warning" role="alert">
        ¿Está seguro de eliminar este registro?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@(Model.Customer != null ? Model.Customer.Email : "-")</dd>
        <dt class="col-sm-3">Creado</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        <dt class="col-sm-3">Actualizado</dt>
        <dd class="col-sm-9">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)

        <button type="submit" class="btn btn-danger">Eliminar</button>
        @Html.ActionLink("Cancelar", "Index", new { }, new { @class = "btn btn-outline-secondary" })
    }
</main>
